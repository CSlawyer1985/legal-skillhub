      "manual_review": [
        "是否删除内部批注和修订但保留底稿审计信息",
        "是否清除文档作者、公司路径和隐藏内容"
      ]
    },
    {
      "id": "termination-calculation-only",
      "prompt": "合成轻量任务：用户已经核验并明确告知解除类型、工作年限、前十二个月平均应得工资、上月工资和地方上年度职工月平均工资，只要求复算 N、N+1、2N 的数学结果，不要求判断解除合法性或程序。",
      "expected_modules": {
        "active": [
          "task_context",
          "jurisdiction",
          "temporal",
          "actors",
          "matter",
          "claims_and_elements",
          "authority_and_interpretation",
          "proof",
          "outcomes_and_enforcement",
          "strategy_and_uncertainty",
          "governance"
        ],
        "not_applicable": [
          "procedure"
        ],
        "blocked": []
      },
      "status_reasons": {
        "procedure": "用户已明确排除程序判断，且本次仅复算已确认输入的数学结果；如用户随后要求判断合法解除、通知或仲裁节点，必须重新激活程序模块。"
      },
      "assertion_ids": [
        "source-fidelity",
        "remedy-quantification-enforcement",
        "workspace-contract",
        "ethics-privacy-human-review",
        "calculation-reproducibility"
      ],
      "manual_review": [
        "是否将已确认输入与法律结论分开",
        "是否明示这是算术复核而不是解除合法性意见"
      ]
