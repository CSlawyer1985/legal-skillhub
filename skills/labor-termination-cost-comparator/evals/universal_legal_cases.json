          "governance"
        ]
      },
      "status_reasons": {
        "governance": {
          "gap": "客户版脱敏、批注/修订清除和人工签发责任尚未完成",
          "fallback": "只生成隔离的本地草稿和底稿，不交付客户版；使用 Office CLI 检查 OOXML、渲染结果和元数据后由签发人复核",
          "human_owner": "签发律师",
          "review_trigger": "清洁检查和人工视觉复核完成后"
