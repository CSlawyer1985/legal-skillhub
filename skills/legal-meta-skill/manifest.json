  "skill_contract": {
    "job": "把重复、证据敏感的中国大陆法律工作流创建、改造、审计或评测为可复用的 Agent Skill",
    "decision": {
      "goal": "决定目标法律工作流是否适合建成 Skill，并确定其能力、边界、成熟度和验证证据",
      "owner": "目标 Skill 的用户或维护人",
      "supported_action": "创建、改造、审计、评测和经单独授权的发布准备"
    },
    "target_users": ["律师", "法律助理", "法律运营与知识管理人员", "法律工作区中的 Agent"],
    "inputs": ["重复法律工作流", "SOP 或既有提示词", "代表性输入与优秀输出", "既有 Skill", "法律来源与项目约束", "评测样例"],
    "outputs": ["自包含法律 Skill 包", "法律能力配置", "输出契约", "触发与输出评测", "证据边界", "创建交接报告"],
    "exclusions": ["一次性法律咨询", "单份文书起草", "普通翻译或总结", "替代律师作出最终法律决定", "未经授权的外传与发布"],
    "workflow": ["意图收敛", "中英文只读研究", "法律 Skill IR 建模", "自包含封装", "双轨评测", "成熟度门禁与交接"],
    "decision_points": ["是否存在重复任务和可复用输出契约", "十二模块分别处于适用、不适用或受阻状态", "目标成熟度是否有相应证据", "是否取得外部写入或发布授权"],
    "failure_modes": ["法域或法律时点不明", "核心法律依据未核验", "材料与事实混同", "证据不足却输出确定结论", "权限或人工复核缺失", "把静态夹具冒充真实运行证据"]
  },
  "legal_profile": {
    "schema_version": "universal-legal-core/v0.1",
    "activation_policy": "mandatory-review-conditional-expansion",
    "jurisdiction_default": "中国大陆",
    "source_policy": "现行法、司法解释、权威案例与本地知识库分层并独立核验",
    "evidence_policy": "材料、事实、法律评价、程序状态四层分离",
    "privacy_default": "local-first-data-stays-local",
    "pdf_policy": "遵守包内法律文件与工作空间规则",
    "modules": {
      "task_context": {"label_zh": "任务目的与受众", "status": "active", "reason": "元技能生成或审查下游任务定义能力", "required_outputs": ["task_type", "decision_goal", "target_users", "audience", "decision_owner", "reviewer"]},
      "jurisdiction": {"label_zh": "法域", "status": "active", "reason": "元技能生成或审查下游法域建模能力", "required_outputs": ["jurisdiction_scope", "governing_law_basis", "forum_or_seat", "conflict_rules"]},
      "temporal": {"label_zh": "时间", "status": "active", "reason": "元技能生成或审查下游时间与期限建模能力", "required_outputs": ["as_of_date", "event_timeline", "applicable_versions", "limitation_and_deadline_checks", "temporal_gaps"]},
      "actors": {"label_zh": "主体角色", "status": "active", "reason": "元技能生成或审查下游主体角色能力", "required_outputs": ["actor_map", "legal_status", "roles_and_interests", "authority_and_capacity", "conflicts_of_interest"]},
      "matter": {"label_zh": "法律事项", "status": "active", "reason": "元技能生成或审查下游法律事项建模能力", "required_outputs": ["issue_scope", "legal_relationships", "issue_tree", "material_facts", "exclusions"]},
      "claims_and_elements": {"label_zh": "请求与要件", "status": "active", "reason": "元技能生成或审查下游请求要件能力", "required_outputs": ["claims_defenses", "legal_elements", "element_fact_mapping", "remedies_requested", "counterarguments"]},
      "authority_and_interpretation": {"label_zh": "法源与解释", "status": "active", "reason": "元技能生成或审查下游法源解释能力", "required_outputs": ["authority_inventory", "authority_hierarchy", "verification_status", "interpretation_method", "application_analysis", "conflicting_authorities"]},
      "proof": {"label_zh": "证明", "status": "active", "reason": "元技能生成或审查下游证明能力", "required_outputs": ["facts_to_prove", "evidence_locator", "burden_of_proof", "standard_of_proof", "evidence_gaps", "adverse_consequences"]},
      "procedure": {"label_zh": "程序", "status": "active", "reason": "元技能生成或审查下游程序能力", "required_outputs": ["forum_and_jurisdiction", "procedural_posture", "procedural_steps", "deadlines_to_verify", "admissibility_or_prerequisites", "procedural_risks"]},
      "outcomes_and_enforcement": {"label_zh": "结果与执行", "status": "active", "reason": "元技能生成或审查下游结果执行能力", "required_outputs": ["outcome_scenarios", "legal_effects", "liability_and_exposure", "enforceability", "enforcement_path", "recovery_constraints"]},
      "strategy_and_uncertainty": {"label_zh": "策略与不确定性", "status": "active", "reason": "元技能生成或审查下游策略与不确定性处理能力", "required_outputs": ["options", "assumptions", "uncertainties", "scenario_analysis", "recommended_actions", "escalation_triggers"]},
      "governance": {"label_zh": "职业治理", "status": "active", "reason": "元技能生成或审查下游职业治理能力", "required_outputs": ["confidentiality_and_data_boundary", "permissions", "human_review", "source_and_audit_trail", "professional_responsibility_limits", "review_cycle"]}
    }
  },
  "downstream_attribution": {
    "default": "include",
    "new_skill": "作者 CSlawyer；主页 https://chenshi.ai；生成工具 legal-meta-skill",
