{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "one-contract/principle-catalog-v1.schema.json",
  "title": "Concrete-type review principle card",
  "type": "object",
  "description": "第三层具体类型原则卡的契约。与第二层的 domain_principle.schema.json 分属不同层级，不可互相替代。字段与约束由 principle_catalog.json 全量实测导出。",
  "required": [
    "doctrine_id", "type_id", "type_code", "name", "version",
    "approval_status", "activation_status", "content_status", "source_status",
    "sample_support_status", "review_objectives", "action_guidance",
    "default_tendencies", "hard_boundaries", "judgment_coordinates",
    "override_factors", "linked_module_ids", "required_source_slots",
    "gold_family_count_local_summary", "representative_family_count_local_summary",
    "legal_checked_at", "reviewed_at", "reviewer"
  ],
  "properties": {
    "doctrine_id": {"type": "string", "pattern": "^doctrine-[a-z0-9-]+$"},
    "type_id": {"type": "string", "pattern": "^type-[a-z0-9-]+$", "description": "关联的具体类型标识，须与 taxonomy_v2.json 的 catalog_types 对应。"},
    "type_code": {"type": "string", "pattern": "^EC-[0-9]{2}-[0-9]{3}$", "description": "类型编码，格式为 EC-<大类两位>-<序号三位>。"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "approval_status": {
      "enum": ["candidate", "lawyer_approved", "regression_passed", "active", "deprecated"],
      "description": "审批轴。与 clause_module / knowledge_source / experience_card 同构。"
    },
    "activation_status": {
      "enum": ["inactive", "active", "deprecated"],
      "description": "执行轴。运行只消费两个状态字段同为 active 的资产。"
    },
    "content_status": {"type": "string", "minLength": 1, "description": "内容版本口径，形如 user_approved_active_<日期> 或 lawyer_approved_v1_migration_<日期>。"},
    "source_status": {"type": "string", "minLength": 1, "description": "来源完备度说明，含 caveat 提示；长度差异较大，不做长度上限约束。"},
    "sample_support_status": {"type": "string", "minLength": 1, "description": "样本支撑度说明，区分本地样本可用性与仅公开来源两种情况。"},
    "review_objectives": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "action_guidance": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "default_tendencies": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "hard_boundaries": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "description": "本条原则的不可覆盖边界。刻意设为开放数组：内容随类型增加而增长，不设上限以免约束真实演进。"},
    "judgment_coordinates": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "override_factors": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "linked_module_ids": {"type": "array", "items": {"type": "string", "pattern": "^mod-[a-z0-9-]+$"}, "minItems": 1},
    "required_source_slots": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "gold_family_count_local_summary": {"type": "integer", "minimum": 0},
    "representative_family_count_local_summary": {"type": "integer", "minimum": 0},
    "legal_checked_at": {"type": ["string", "null"], "format": "date", "description": "法律核验日期。允许 null：迁移期尚有未完成核验的条目。格式用 format:date 而非 pattern——pattern 只能校验形状，拦不住 2026-13-45 这类非法月日。"},
    "reviewed_at": {"type": ["string", "null"], "format": "date", "description": "审阅日期。允许 null：同上。"},
    "reviewer": {"type": ["string", "null"], "minLength": 1, "description": "审阅者自述身份。允许 null。本字段为单用户留痕，不构成身份认证或不可抵赖（ADR-024）。"},
    "activated_at": {"type": "string", "format": "date", "description": "可选：激活日期。并非所有条目都记录激活时间，缺失不代表未生效。"},
    "activation_basis": {"type": "string", "minLength": 1, "description": "可选：激活依据说明。"},
    "migration_summary": {"type": "string", "minLength": 1, "description": "可选：v1 迁移期的处置摘要，记录本条原则的取舍理由。"},
    "source_ids": {"type": "array", "items": {"type": "string", "pattern": "^src-[a-z0-9-]+$"}, "minItems": 1, "description": "可选：关联来源。迁移期部分条目尚未挂接来源。"}
  },
  "additionalProperties": false
}
