{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "one-contract/api-envelope-v1.schema.json",
  "title": "One-Contract Rule Studio API Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "request_id",
    "success",
    "result",
    "error"
  ],
  "properties": {
    "api_version": {
      "const": "v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 120
    },
    "success": {
      "type": "boolean"
    },
    "result": {
      "type": [
        "object",
        "array",
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/error"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "success": {
            "const": true
          }
        },
        "required": [
          "success"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "success": {
            "const": false
          }
        },
        "required": [
          "success"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "type": "null"
          },
          "error": {
            "$ref": "#/$defs/error"
          }
        }
      }
    }
  ],
  "$defs": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "field_path",
        "remediation"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,99}$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "field_path": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "remediation": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1200
        },
        "details": {
          "type": "object"
        }
      }
    }
  },
  "$comment": "W1 校准：由开发交接包 config 草案迁入产品 package；本目录版本为唯一运行时真源（ADR-027）。"
}
