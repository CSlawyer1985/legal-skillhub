{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "one-contract/client-profile-v1.schema.json",
  "title": "One-Contract Client Profile",
  "$comment": "content_sha256 is SHA-256 over RFC 8785/JCS canonical JSON with only content_sha256 omitted. This private profile is never included in a public product export. W1 校准：由开发交接包 config 草案迁入产品 package；本目录版本为唯一运行时真源（ADR-027）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "client_profile_id",
    "display_name",
    "selection_policy",
    "status",
    "revision",
    "created_at",
    "updated_at",
    "created_by",
    "updated_by",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "client_profile_id": {
      "type": "string",
      "pattern": "^cp_[a-z0-9][a-z0-9_-]{7,63}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "aliases": {
      "type": "array",
      "maxItems": 30,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "default": []
    },
    "selection_policy": {
      "const": "explicit"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "deprecated"
      ]
    },
    "default_scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domain_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^EC-[0-9]{2}$"
          }
        },
        "type_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120
          }
        },
        "roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          }
        },
        "scene_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          }
        }
      },
      "default": {}
    },
    "notes": {
      "type": "string",
      "maxLength": 1000
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "updated_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
