{
  "_version": "1.1.0",
  "_updated_at": "2026-08-20",
  "说明": "案号格式校验正则表达式库——按文书类型分列正则表达式（括号兼容全角（）与半角()两种写法，与pii_sanitizer.py口径一致），每条附脱敏示例。供case_number_validator.py消费。",
  "formats": {
    "一审刑事判决书": {
      "pattern": "^[（(](19|20)\\d{2}[）)].{0,8}刑初\\d+号$",
      "sanitized_example": "（20XX）X刑初XX号"
    },
    "二审刑事判决书": {
      "pattern": "^[（(](19|20)\\d{2}[）)].{0,8}刑终\\d+号$",
      "sanitized_example": "（20XX）X刑终XX号"
    },
    "再审刑事判决书": {
      "pattern": "^[（(](19|20)\\d{2}[）)].{0,8}刑再\\d+号$",
      "sanitized_example": "（20XX）X刑再XX号"
    },
    "死刑复核刑事裁定书": {
      "pattern": "^[（(](19|20)\\d{2}[）)].{0,8}刑核\\d+号$",
      "sanitized_example": "（20XX）X刑核XX号"
    },
    "执行刑事裁定书": {
      "pattern": "^[（(](19|20)\\d{2}[）)].{0,8}刑执\\d+号$",
      "sanitized_example": "（20XX）X刑执XX号"
    },
    "减刑假释刑事裁定书": {
      "pattern": "^[（(](19|20)\\d{2}[）)].{0,8}刑更\\d+号$",
      "sanitized_example": "（20XX）X刑更XX号"
    },
    "检察院起诉书": {
      "pattern": "^.{0,12}检刑诉[〔[](19|20)\\d{2}[〕]]\\d+号$",
      "sanitized_example": "X检刑诉〔20XX〕XX号"
    },
    "检察院不起诉决定书": {
      "pattern": "^.{0,12}检刑不诉[〔[](19|20)\\d{2}[〕]]\\d+号$",
      "sanitized_example": "X检刑不诉〔20XX〕XX号"
    },
    "审查逮捕相关文书": {
      "pattern": "^.{0,12}检[〔[](19|20)\\d{2}[〕]]\\d+号$",
      "sanitized_example": "X检〔20XX〕XX号"
    },
    "旧式刑事案号（2016年前）": {
      "pattern": "^[（(](19|20)\\d{2}[）)].{0,8}刑[初终再]字第\\d+号$",
      "sanitized_example": "（20XX）X刑初字第XX号",
      "era_note": "2016年1月1日《人民法院案件编号规则》施行前法院案号使用\"字第\"格式；年份2016年及以后出现该格式的为虚构案号特征，年份2015年及以前的为旧式合法格式"
    }
  },
  "notes": [
    "2016年1月1日起法院案号不再使用\"刑初字第\"格式；出现旧式\"字第\"格式须结合案件年代判断真伪（case_number_validator.py内置年代判断：年份≤2015为旧式合法，年份≥2016为虚构特征）",
    "案号中年份须为四位数字；法院代字与案件类型代字以《人民法院案件编号规则》为准",
    "括号兼容全角（）与半角()两种写法，与pii_sanitizer.py的案号脱敏正则口径一致",
    "本库覆盖常见刑事案号类型；特殊案号格式未收录时输出\"不符合任何已知格式\"并提示人工核实"
  ]
}
