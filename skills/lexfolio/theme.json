            "alignment": "left",
            "space_before_pt": 3,
            "space_after_pt": 3
          },
          "heading_1": {
            "font_size_pt": 15,
            "line_height_pt": 24,
            "space_before_pt": 20,
            "space_after_pt": 8
          },
          "heading_2": {
            "font_size_pt": 13,
            "line_height_pt": 21,
            "space_before_pt": 16,
