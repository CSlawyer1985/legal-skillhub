      "overrides": {
        "typography": {
          "body": {
            "font_size_pt": 13,
            "line_height_pt": 24,
            "space_before_pt": 4,
            "space_after_pt": 4
          },
          "heading_1": {
            "font_size_pt": 17,
            "line_height_pt": 26,
            "space_before_pt": 22,
            "space_after_pt": 10
          },
          "heading_2": {
            "font_size_pt": 15,
            "line_height_pt": 24,
            "space_before_pt": 18,
            "space_after_pt": 8
          },
          "heading_3": {
            "font_size_pt": 13,
            "line_height_pt": 20,
            "space_before_pt": 14,
            "space_after_pt": 6
          }
        },
        "page": {
          "margin_top_mm": 25,
          "margin_bottom_mm": 25,
          "margin_right_mm": 32
        }
      }
    },
    "mobile": {
      "label": "移动友好",
      "category": "备忘录",
