          "cell_padding_vertical_pt": 3,
          "cell_padding_horizontal_pt": 5,
          "header_bg_opacity": 0.12,
          "font_size_pt": 9.5,
          "line_height_pt": 14
        }
      }
    },
    "redline": {
      "label": "修订注释",
      "category": "合同审查",
      "description": "宽松行距大字号，适合合同逐条审查批注",
      "overrides": {
        "typography": {
          "body": {
            "font_size_pt": 11,
