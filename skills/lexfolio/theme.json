      "overrides": {
        "typography": {
          "body": {
            "font_size_pt": 10,
            "line_height_pt": 19,
            "space_before_pt": 2,
            "space_after_pt": 2
          },
          "heading_1": {
            "font_size_pt": 14,
            "line_height_pt": 22,
            "space_before_pt": 16,
            "space_after_pt": 6
          },
          "heading_2": {
            "font_size_pt": 12,
            "line_height_pt": 19,
            "space_before_pt": 12,
            "space_after_pt": 4
          },
          "heading_3": {
            "font_size_pt": 11,
            "line_height_pt": 18,
            "space_before_pt": 10,
            "space_after_pt": 3
          }
        },
        "page": {
          "margin_left_mm": 38,
          "margin_right_mm": 38
