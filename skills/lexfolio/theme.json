      }
    },
    "matrix": {
      "label": "条款对比",
      "category": "合同审查",
      "description": "横排A4紧凑表格，适合条款逐项对比分析",
      "overrides": {
        "page": {
          "size": "A4_landscape",
          "width_mm": 297,
          "height_mm": 210,
          "margin_top_mm": 20,
          "margin_bottom_mm": 20,
          "margin_left_mm": 25,
          "margin_right_mm": 25
        },
        "typography": {
          "body": {
            "font_size_pt": 10,
