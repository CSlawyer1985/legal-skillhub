      "description": "大标题配合品牌色装饰线，杂志风格排版",
      "overrides": {
        "typography": {
          "body": {
            "font_size_pt": 12,
            "line_height_pt": 24,
            "space_before_pt": 4,
            "space_after_pt": 4
          },
          "heading_1": {
            "font_size_pt": 20,
            "line_height_pt": 30,
            "space_before_pt": 24,
            "space_after_pt": 10
          },
          "heading_2": {
            "font_size_pt": 15,
            "line_height_pt": 24,
            "space_before_pt": 18,
            "space_after_pt": 8
          },
          "heading_3": {
            "font_size_pt": 13,
