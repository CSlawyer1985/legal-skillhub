  "status": "candidate-local-only",
  "locator_profiles": {
    "document_profile": "l2-markdown-paragraph-table-v1",
    "downstream_source_ref_profile": "downstream-source-ref-v1",
    "allowed_item_locator_patterns": [
      "SOURCE_ID#pN",
      "SOURCE_ID#para-N",
      "SOURCE_ID#cell-A1",
      "SOURCE_ID#ts-HH:MM:SS"
    ],
    "l2_anchor_map_locator_kinds": [
      "para-N",
      "cell-A1"
    ],
    "source_ledger_prefix_rule": "locator_prefix MUST equal source_id followed by #"
