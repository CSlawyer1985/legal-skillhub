      "document_id",
      "document_sha256",
      "locator_profile",
      "anchors"
    ],
    "anchor_entry_required_fields": [
      "anchor_id",
      "locators",
      "status"
    ],
    "anchor_statuses": [
      "present",
      "empty_hold",
      "not_applicable"
    ],
    "empty_hold_rule": "A required anchor without supported content MUST remain empty_hold and MUST NOT be omitted or guessed."
  },
  "stable_anchors": [
