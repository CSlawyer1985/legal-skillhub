{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/litigation-visualization-handoff-v1.schema.json",
  "title": "Gaotao litigation visualization handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handoff_id",
    "created_at",
    "upstream",
    "route",
    "validator_compatibility",
    "source_ledger",
    "privacy_authorization",
    "legal_review",
    "workflow_status",
    "hold_control",
    "gates",
    "write_back_allowed"
  ],
  "properties": {
    "schema_version": {
      "const": "litigation-visualization-handoff/1.0"
    },
    "handoff_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gaotao_skill",
        "case_skill",
        "litigation_plan"
      ],
      "properties": {
        "gaotao_skill": {
          "$ref": "#/$defs/skillBinding"
        },
        "case_skill": {
          "$ref": "#/$defs/skillBinding"
        },
        "litigation_plan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact_id",
            "artifact_version",
            "artifact_sha256",
            "relative_path",
            "source_id",
            "source_cutoff",
            "locator_profile",
            "anchor_contract_version",
            "anchor_contract_sha256",
            "anchor_map_relative_path",
            "anchor_map_sha256",
            "filing_status"
          ],
          "properties": {
            "artifact_id": {
              "const": "L2-05"
            },
            "artifact_version": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "artifact_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "relative_path": {
              "$ref": "#/$defs/relativePath"
            },
            "source_id": {
              "$ref": "#/$defs/sourceId"
            },
            "source_cutoff": {
              "type": "string",
              "format": "date"
            },
            "locator_profile": {
              "const": "l2-markdown-paragraph-table-v1"
            },
            "anchor_contract_version": {
              "const": "l2-anchor-contract/1.0"
            },
            "anchor_contract_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "anchor_map_relative_path": {
              "$ref": "#/$defs/relativePath"
            },
            "anchor_map_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "filing_status": {
              "const": "internal_work_product"
            }
          }
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "downstream_skill",
        "output_profile",
        "capability_status",
        "trigger",
        "requested_views"
      ],
      "properties": {
        "downstream_skill": {
          "$ref": "#/$defs/skillBinding"
        },
        "output_profile": {
          "const": "professional_service.litigation_visualization"
        },
        "capability_status": {
          "enum": [
            "supported",
            "hold",
            "not_applicable"
          ]
        },
        "trigger": {
          "enum": [
            "on_request",
            "explicit_package_option"
          ]
        },
        "requested_views": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "case_process_flow",
              "claim_evidence_matrix"
            ]
          }
        }
      }
    },
    "validator_compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "downstream_skill_id",
        "validate_spec_sha256",
        "validate_output_sha256",
        "privacy_contract",
        "source_ledger_contract",
        "source_ref_contract"
      ],
      "properties": {
        "downstream_skill_id": {
          "const": "litigation-visualization-cn"
        },
        "validate_spec_sha256": {
          "const": "5b71446ea24710e8624875ae55cc568f5a257956457624769f4cc67b7b0b5f06"
        },
        "validate_output_sha256": {
          "const": "84bd8acd9524d528f976877b21137653632e5b4e86501280d2b09ba92720d47a"
        },
        "privacy_contract": {
          "const": "local-only-internal-parties-v1"
        },
        "source_ledger_contract": {
          "const": "downstream-source-ledger-11-fields-v1"
        },
        "source_ref_contract": {
          "const": "downstream-source-ref-v1"
        }
      }
    },
    "source_ledger": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceLedgerItem"
      }
    },
    "privacy_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processing_location",
        "allowed_processors",
        "allowed_recipients",
        "allowed_channel",
        "field_allowlist",
        "redaction_status",
        "retention_policy",
        "human_release_approved",
        "human_release_by",
        "human_release_at",
        "authorization_basis",
        "external_processing_authorized",
        "external_delivery_authorized"
      ],
      "properties": {
        "processing_location": {
          "const": "local_only"
        },
        "allowed_processors": {
          "$ref": "#/$defs/internalPartyArray"
        },
        "allowed_recipients": {
          "$ref": "#/$defs/internalPartyArray"
        },
        "allowed_channel": {
          "const": "local_only"
        },
        "field_allowlist": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "case_id",
              "labels",
              "facts",
              "legal_rules",
              "source_ids",
              "dates",
              "amounts",
              "relationships",
              "procedures",
              "notes"
            ]
          }
        },
        "redaction_status": {
          "enum": [
            "not_required",
            "internal_minimized",
            "pending",
            "completed"
          ]
        },
        "retention_policy": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "human_release_approved": {
          "type": "boolean"
        },
        "human_release_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "human_release_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "authorization_basis": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "external_processing_authorized": {
          "const": false
        },
        "external_delivery_authorized": {
          "const": false
        }
      }
    },
    "legal_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "jurisdiction",
        "effective_at",
        "law_checked_at",
        "law_check_status",
        "reviewer",
        "legal_rule_refs"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "jurisdiction": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "effective_at": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "law_checked_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "law_check_status": {
          "enum": [
            "not_required",
            "pending",
            "verified"
          ]
        },
        "reviewer": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "legal_rule_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        }
      }
    },
    "workflow_status": {
      "enum": [
        "ready",
        "research_draft",
        "hold"
      ]
    },
    "hold_control": {
      "type": [
        "object",
        "null"
      ]
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "litigation_plan_frozen",
        "source_ledger_complete",
        "privacy_authorized",
        "semantic_spec_valid",
        "independent_semantic_review_pass",
        "render_allowed"
      ],
      "properties": {
        "litigation_plan_frozen": {
          "type": "boolean"
        },
        "source_ledger_complete": {
          "type": "boolean"
        },
        "privacy_authorized": {
          "type": "boolean"
        },
        "semantic_spec_valid": {
          "type": "boolean"
        },
        "independent_semantic_review_pass": {
          "type": "boolean"
        },
        "render_allowed": {
          "type": "boolean"
        }
      }
    },
    "write_back_allowed": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "workflow_status": {
            "const": "hold"
          }
        },
        "required": [
          "workflow_status"
        ]
      },
      "then": {
        "properties": {
          "hold_control": {
            "$ref": "#/$defs/holdControl"
          }
        }
      },
      "else": {
        "properties": {
          "hold_control": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "route": {
            "properties": {
              "capability_status": {
                "enum": [
                  "hold",
                  "not_applicable"
                ]
              }
            },
            "required": [
              "capability_status"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "gates": {
            "properties": {
              "render_allowed": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "gates": {
            "properties": {
              "render_allowed": {
                "const": true
              }
            },
            "required": [
              "render_allowed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "route": {
            "properties": {
              "capability_status": {
                "const": "supported"
              }
            }
          },
          "gates": {
            "properties": {
              "litigation_plan_frozen": {
                "const": true
              },
              "source_ledger_complete": {
                "const": true
              },
              "privacy_authorized": {
                "const": true
              },
              "semantic_spec_valid": {
                "const": true
              },
              "independent_semantic_review_pass": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "privacy_authorization": {
            "properties": {
              "human_release_approved": {
                "const": false
              }
            },
            "required": [
              "human_release_approved"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "privacy_authorization": {
            "properties": {
              "human_release_by": {
                "type": "null"
              },
              "human_release_at": {
                "type": "null"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "privacy_authorization": {
            "properties": {
              "human_release_by": {
                "$ref": "#/$defs/internalParty"
              },
              "human_release_at": {
                "type": "string",
                "format": "date"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/|~|[A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "internalParty": {
      "type": "string",
      "pattern": "^internal:[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "internalPartyArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/internalParty"
      }
    },
    "skillBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_id",
        "version",
        "skill_sha256",
        "manifest_or_contract_sha256"
      ],
      "properties": {
        "skill_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "skill_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "manifest_or_contract_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sourceRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*#(?:p[1-9][0-9]*|para-[1-9][0-9]*|cell-[A-Za-z]{1,4}[1-9][0-9]*|ts-(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9])$"
    },
    "sourceLedgerItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_kind",
        "source_hash_or_version",
        "custody_or_processing_location",
        "ingested_at",
        "source_cutoff",
        "authorized_use",
        "locator_prefix",
        "page_or_unit_locator_scheme",
        "ocr_or_derivation_note",
        "description"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/sourceId"
        },
        "source_kind": {
          "enum": [
            "evidence",
            "party_statement",
            "legal_authority",
            "decision",
            "context",
            "derived"
          ]
        },
        "source_hash_or_version": {
          "type": "string",
          "pattern": "^(?:sha256:[a-f0-9]{64}|version:[A-Za-z0-9][A-Za-z0-9._:+-]{0,199}|unhashed-with-reason:.{3,200})$"
        },
        "custody_or_processing_location": {
          "const": "local_only"
        },
        "ingested_at": {
          "type": "string",
          "format": "date"
        },
        "source_cutoff": {
          "type": "string",
          "format": "date"
        },
        "authorized_use": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "locator_prefix": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*#$"
        },
        "page_or_unit_locator_scheme": {
          "const": "SOURCE_ID#pN | SOURCE_ID#para-N | SOURCE_ID#cell-A1 | SOURCE_ID#ts-HH:MM:SS"
        },
        "ocr_or_derivation_note": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "holdControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "reason",
        "owner",
        "recovery_conditions"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "owner": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "recovery_conditions": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    }
  }
}
