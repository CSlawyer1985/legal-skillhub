# PatSeek API Key 配置示例
# ============================================================
# ⚠️ 本文件仅作格式示例，**不含任何真实 Key**。
#
# 使用方式（任选其一）：
#   1. 复制本文件为 .env：   cp .env.example .env
#   2. 编辑 .env，填入你的真实 Key
#   3. 保存即可，技能启动时会自动加载
#
# 获取 Key：https://patseek.cn → 个人中心 → API Key 管理
# 格式：ps_ + 32 位十六进制字符串
#
# ⚠️ **禁止把 .env 提交到 git**（已在 .gitignore 忽略 .env）
# ============================================================

PATSEEK_API_KEY=ps_your_real_key_here_replace_me

# ============================================================
# 可选：其他环境变量（如未来扩展）
# ============================================================
# PATSEEK_BASE_URL=https://patseek.cn
# LOG_LEVEL=INFO
