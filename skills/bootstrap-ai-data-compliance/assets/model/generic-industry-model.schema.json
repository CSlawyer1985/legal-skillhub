{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "通用产业AI数据合规全景模型",
  "description": "产业无关的AI数据合规全景模型 schema。由 Skill 基于 intake 信息自动生成，供 panorama 渲染器出图与报告。脑机接口专属硬约束已放宽为适度下限。",
  "type": "object",
  "required": [
    "meta", "phases", "stages", "businessNodes", "technologyNodes", "dataNodes",
    "layerLinks", "systemNodes", "dataObjects", "dataEdges",
    "risks", "gates", "documents", "sources", "verificationItems"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "version", "legalBoundary", "industry"],
      "properties": {
        "title": { "type": "string" },
        "version": { "type": "string" },
        "industry": { "type": "string", "description": "产业名称（如 零售电商客服、脑机接口医疗AI）" },
        "legalBoundary": { "const": "基于既有材料，法规版本及适用性待专项校验" }
      }
    },
    "phases": {
      "type": "array",
      "description": "业务路径（如 A内部研发 / B科研合作 / C消费者服务），产业可按需定义",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "priority": { "type": "string" },
          "focusEventIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 3,
      "description": "流程阶段（三层流程图列），产业按实际流程定义",
      "items": {
        "type": "object",
        "required": ["id", "index", "name", "eventIds"],
        "properties": {
          "id": { "type": "string", "pattern": "^S\\d{2}$" },
          "index": { "type": "integer" },
          "name": { "type": "string" },
          "eventIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "businessNodes": {
      "type": "array",
      "minItems": 3,
      "description": "业务层节点（三层流程图中层）",
      "items": { "$ref": "#/$defs/processNode" }
    },
    "technologyNodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/processNode" }
    },
    "dataNodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/processNode" }
    },
    "layerLinks": {
      "type": "array",
      "description": "业务→技术→数据 层间链接",
      "items": {
        "type": "object",
        "required": ["id", "from", "to"],
        "properties": {
          "id": { "type": "string" },
          "from": { "type": "string" },
          "to": { "type": "string" }
        }
      }
    },
    "systemNodes": {
      "type": "array",
      "minItems": 3,
      "description": "数据流图系统节点。x/y 由 Skill 自动布局生成（渲染器依赖坐标）",
      "items": {
        "type": "object",
        "required": ["id", "role", "name", "category", "factStatus"],
        "properties": {
          "id": { "type": "string", "pattern": "^SYS\\d{2}$" },
          "role": { "type": "string" },
          "name": { "type": "string" },
          "actualSystemName": { "type": "string" },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "category": { "enum": ["external", "internal", "device", "third_party"] },
          "factStatus": { "enum": ["已确认", "待核实", "初步判断", "不适用"] }
        }
      }
    },
    "dataObjects": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "name", "classification"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "classification": { "type": "string", "description": "个人信息/敏感个人信息/重要数据/非个人信息" }
        }
      }
    },
    "dataEdges": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/dataFlowEdge" }
    },
    "risks": {
      "type": "array",
      "minItems": 2,
      "description": "风险清单（简单评估报告核心）",
      "items": {
        "type": "object",
        "required": ["id", "familyId", "theme", "description", "certainty"],
        "properties": {
          "id": { "type": "string" },
          "familyId": { "type": "string" },
          "theme": { "type": "string" },
          "description": { "type": "string" },
          "sourceIds": { "type": "array", "items": { "type": "string" } },
          "eventIds": { "type": "array", "items": { "type": "string" } },
          "likelihood": { "enum": ["高", "中", "低"] },
          "impact": { "enum": ["高", "中", "低"] },
          "level": { "enum": ["高", "中", "低"] },
          "certainty": { "enum": ["已确认", "待核实", "事实冲突", "初步判断", "不适用"] }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "description"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "eventIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "description": "合规文书清单（后续文件包基础）",
      "items": {
        "type": "object",
        "required": ["id", "name", "purpose"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "purpose": { "type": "string" },
          "status": { "enum": ["待编制", "候选", "已复核"] }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "description": "法源引用（来自知识库索引）",
      "items": {
        "type": "object",
        "required": ["id", "title", "evidenceLabel"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "version": { "type": "string" },
          "evidenceLabel": { "enum": ["文件明确记载", "多个文件归纳", "需律师确认", "无直接法源", "客户事实待核实"] }
        }
      }
    },
    "verificationItems": {
      "type": "array",
      "description": "待核验项（进企调研前提示）",
      "items": {
        "type": "object",
        "required": ["id", "question"],
        "properties": {
          "id": { "type": "string" },
          "question": { "type": "string" },
          "targetRole": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "processNode": {
      "type": "object",
      "required": ["id", "name", "stageId"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "stageId": { "type": "string", "pattern": "^S\\d{2}$" },
        "phaseId": { "type": "string" },
        "factStatus": { "enum": ["已确认", "待核实", "初步判断", "不适用"] }
      }
    },
    "dataFlowEdge": {
      "type": "object",
      "required": ["id", "from", "to", "dataObjectIds"],
      "properties": {
        "id": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "dataObjectIds": { "type": "array", "items": { "type": "string" } },
        "direction": { "enum": ["bidirectional", "one_way"] }
      }
    }
  }
}
